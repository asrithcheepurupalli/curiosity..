---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

// Hide drafts and any post whose date is still in the future (scheduled publishing).
const allPosts = (await getCollection('posts')).filter(
  p => !p.data.draft && new Date(p.data.date).getTime() <= Date.now()
);

allPosts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const postsByYear: Record<string, typeof allPosts> = {};
for (const post of allPosts) {
  const year = new Date(post.data.date).getFullYear().toString();
  if (!postsByYear[year]) postsByYear[year] = [];
  postsByYear[year].push(post);
}

const years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));
const currentYear = years[0];

const slugs = allPosts.map(p => p.slug);

// Newest pinned post gets the big "Special mention" card above the archive.
const pinned = allPosts.find(p => p.data.pinned);

const siteJsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Curiosity Log",
  "description": "Small questions about everyday things. A minimalist inquiry into the mechanics of the ordinary.",
  "url": "https://curiosity.asrithcheepurupalli.tech",
  "author": {
    "@type": "Organization",
    "name": "Curiosity Log"
  },
  "blogPost": allPosts.slice(0, 10).map(p => ({
    "@type": "BlogPosting",
    "headline": p.data.title,
    "description": p.data.description,
    "datePublished": new Date(p.data.date).toISOString(),
    "url": `https://curiosity.asrithcheepurupalli.tech/posts/${p.slug}`
  }))
};

function formatMonthDay(dateStr: string) {
  const d = new Date(dateStr);
  const mm = String(d.getMonth() + 1).padStart(2, '0');
  const dd = String(d.getDate()).padStart(2, '0');
  return `${mm}.${dd}`;
}
---

<Layout
  title="Curiosity Log — Small questions about everyday things"
  description="A minimalist inquiry into the mechanics of the everyday. Small questions about ordinary things."
>
  <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />

  <script define:vars={{ slugs }}>
    window.__POSTS__ = slugs;
  </script>

  <div class="page-wrapper">
    <aside class="vertical-text" aria-hidden="true">
      <span>OBSERVATORY OF THE ORDINARY</span>
    </aside>

    <div class="page-content">
      <section class="hero-section">
        <p class="label hero-label">Introduction</p>
        <h1 class="hero-heading">
          Small questions about <em>everyday</em> things. Inquiry into the ordinary.
        </h1>
        <div class="hero-accent-line"></div>
        <div class="hero-actions">
          <button class="surprise-btn" id="surpriseBtn">
            <span>Surprise Me</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </button>
        </div>
      </section>

      <div class="vol-tag" aria-hidden="true">Vol. 01</div>

      {pinned && (
        <section class="pinned" aria-labelledby="pinned-title">
          <div class="pinned-head">
            <span class="label pinned-kicker">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 3l5 5-3 1-4 4 1 5-2 2-4-4-5 5-1-1 5-5-4-4 2-2 5 1 4-4z"/></svg>
              Special mention
            </span>
            {pinned.data.pinnedLabel && <span class="label pinned-sub">{pinned.data.pinnedLabel}</span>}
          </div>

          <article class="pinned-card">
            <a href={pinned.data.pinnedCta?.href ?? `/posts/${pinned.slug}`} class="pinned-visual" aria-label={pinned.data.pinnedCta?.label ?? 'Read the post'}>
              <div class="pv-scene" aria-hidden="true">
                <div class="pv-sun"></div><div class="pv-sea"></div><div class="pv-rain"></div>
                <span class="pv-ad"><b>Ad</b> 1 of 2 · 0:06</span>
                <span class="pv-chip"><i></i>No ads tonight · <em>₹19</em></span>
              </div>
            </a>

            <div class="pinned-body">
              <p class="label pinned-date">{formatMonthDay(pinned.data.date)} · {pinned.data.readingTime} min read</p>
              <h2 class="pinned-title" id="pinned-title">
                <a href={`/posts/${pinned.slug}`}>{pinned.data.title}</a>
              </h2>
              <p class="pinned-desc">{pinned.data.description}</p>
              <div class="pinned-actions">
                <a href={`/posts/${pinned.slug}`} class="pinned-btn primary">
                  Read the essay
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
                {pinned.data.pinnedCta && (
                  <a href={pinned.data.pinnedCta.href} class="pinned-btn">{pinned.data.pinnedCta.label}</a>
                )}
              </div>
            </div>
          </article>
        </section>
      )}

      {years.map((year, i) => (
        <section class="archive-section" style={`--section-index:${i}`}>
          <div class="archive-year-row">
            <h2 class="archive-year">{year}</h2>
            <span class="label archive-label">
              {year === currentYear ? '— current archive' : '— previous archive'}
            </span>
          </div>
          <div class="archive-list">
            {postsByYear[year].map((post) => (
              <a href={`/posts/${post.slug}`} class="archive-item">
                <span class="archive-date label">{formatMonthDay(post.data.date)}</span>
                <span class="archive-title">{post.data.title}</span>
                {post.data.pinned && (
                  <span class="archive-pin" title="Special mention">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-label="Pinned"><path d="M16 3l5 5-3 1-4 4 1 5-2 2-4-4-5 5-1-1 5-5-4-4 2-2 5 1 4-4z"/></svg>
                  </span>
                )}
                <span class="archive-arrow" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <line x1="7" y1="17" x2="17" y2="7"/>
                    <polyline points="7 7 17 7 17 17"/>
                  </svg>
                </span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</Layout>

<style>
  .page-wrapper {
    position: relative;
    display: flex;
  }

  .vertical-text {
    position: fixed;
    left: 0;
    top: 50%;
    transform: translateY(-50%) rotate(-90deg);
    transform-origin: center center;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--divider);
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
    writing-mode: vertical-rl;
    transform: none;
    left: 16px;
    top: 50%;
  }

  .page-content {
    flex: 1;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 calc(var(--spacing-unit) * 3);
  }

  .hero-section {
    padding-top: calc(var(--spacing-unit) * 8);
    padding-bottom: calc(var(--spacing-unit) * 10);
    border-bottom: 1px solid var(--divider);
    margin-bottom: calc(var(--spacing-unit) * 8);
    position: relative;
    animation: fade-up 0.6s ease both;
  }

  .hero-label {
    display: block;
    margin-bottom: calc(var(--spacing-unit) * 3);
  }

  .hero-heading {
    font-family: var(--font-body);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 300;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--text);
    max-width: 600px;
    margin-bottom: calc(var(--spacing-unit) * 4);
  }

  .hero-heading em {
    font-style: italic;
    font-weight: 300;
  }

  .hero-accent-line {
    width: 40px;
    height: 2px;
    background: var(--accent);
    margin-bottom: calc(var(--spacing-unit) * 5);
    transform-origin: left;
    animation: line-grow 0.5s 0.3s ease both;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: calc(var(--spacing-unit) * 3);
  }

  .surprise-btn {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--spacing-unit));
    background: none;
    border: 1px solid var(--divider);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-muted);
    padding: calc(var(--spacing-unit) * 1.25) calc(var(--spacing-unit) * 2);
    transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }

  .surprise-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-dim);
  }

  .vol-tag {
    position: fixed;
    left: 16px;
    bottom: 80px;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.15em;
    color: var(--divider);
    text-transform: uppercase;
    user-select: none;
    pointer-events: none;
  }

  /* Special mention */
  .pinned {
    margin-bottom: calc(var(--spacing-unit) * 10);
    animation: fade-up 0.5s 0.15s ease both;
  }

  .pinned-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: calc(var(--spacing-unit) * 2);
    margin-bottom: calc(var(--spacing-unit) * 3);
  }

  .pinned-kicker {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--accent);
    font-size: 0.65rem;
    letter-spacing: 0.18em;
  }

  .pinned-sub {
    font-size: 0.6rem;
    letter-spacing: 0.15em;
  }

  .pinned-card {
    display: grid;
    grid-template-columns: 1fr;
    border: 1px solid var(--divider);
    background: linear-gradient(135deg, var(--accent-dim), transparent 55%);
    transition: border-color 0.25s ease, transform 0.35s cubic-bezier(.32,.72,0,1);
  }

  .pinned-card:hover {
    border-color: var(--accent);
  }

  .pinned-visual {
    display: block;
    padding: calc(var(--spacing-unit) * 2);
  }

  .pv-scene {
    position: relative;
    aspect-ratio: 16 / 7;
    overflow: hidden;
    border-radius: 6px;
    background: linear-gradient(180deg, #1B2A4A 0%, #3B4A72 38%, #C9866B 64%, #2A2F3F 66%, #121722 100%);
    container-type: inline-size;
  }

  .pv-sun {
    position: absolute; left: 50%; top: 52%;
    width: 24cqw; height: 24cqw; border-radius: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, #FFD9A8 0%, #F2A27A 45%, rgba(242,162,122,0) 70%);
  }

  .pv-sea {
    position: absolute; left: 0; right: 0; top: 66%; bottom: 0;
    background: repeating-linear-gradient(180deg, rgba(255,210,170,.10) 0 2px, transparent 2px 9px);
  }

  .pv-rain {
    position: absolute; inset: -20% 0 0 0; opacity: .5;
    background-image: repeating-linear-gradient(100deg, rgba(255,255,255,.16) 0 1px, transparent 1px 14px);
    animation: pv-rain .5s linear infinite;
  }

  @keyframes pv-rain { to { background-position: 0 28px; } }

  .pv-ad {
    position: absolute; left: 4cqw; bottom: 5cqw;
    font-family: var(--font-body); font-size: clamp(9px, 3cqw, 12px); font-weight: 600;
    color: #fff; background: rgba(0,0,0,.55); padding: 3px 8px; border-radius: 999px;
  }

  .pv-ad b { background: #FFD43B; color: #000; padding: 0 4px; border-radius: 3px; margin-right: 4px; }

  .pv-chip {
    position: absolute; right: 4cqw; bottom: 5cqw;
    display: inline-flex; align-items: center; gap: 6px;
    font-family: var(--font-body); font-size: clamp(10px, 3.4cqw, 14px); font-weight: 600; color: #fff;
    background: rgba(15,15,16,.82); border: 1px solid rgba(255,255,255,.18);
    padding: 6px 11px; border-radius: 999px;
    transition: transform 0.4s cubic-bezier(.32,.72,0,1);
  }

  .pv-chip i { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 3px rgba(46,204,113,.25); }
  .pv-chip em { font-style: normal; font-family: var(--font-mono); color: var(--accent); }

  .pinned-visual:hover .pv-chip { transform: translateY(-3px) scale(1.04); }

  .pinned-body {
    padding: calc(var(--spacing-unit) * 1) calc(var(--spacing-unit) * 4) calc(var(--spacing-unit) * 4);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .pinned-date {
    font-size: 0.6rem;
    margin-bottom: calc(var(--spacing-unit) * 1.5);
  }

  .pinned-title {
    font-family: var(--font-body);
    font-size: clamp(1.5rem, 3.6vw, 2.25rem);
    font-weight: 300;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin-bottom: calc(var(--spacing-unit) * 1.5);
  }

  .pinned-title a { color: var(--text); text-decoration: none; }
  .pinned-title a:hover { color: var(--accent); }

  .pinned-desc {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 560px;
    margin-bottom: calc(var(--spacing-unit) * 3);
  }

  .pinned-actions {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--spacing-unit) * 1.5);
  }

  .pinned-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text-muted);
    border: 1px solid var(--divider);
    padding: calc(var(--spacing-unit) * 1.25) calc(var(--spacing-unit) * 2);
    transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease, transform 0.25s cubic-bezier(.32,.72,0,1);
  }

  .pinned-btn:hover { color: var(--accent); border-color: var(--accent); background: var(--accent-dim); }
  .pinned-btn:active { transform: scale(.97); }
  .pinned-btn.primary { color: var(--bg); background: var(--text); border-color: var(--text); }
  .pinned-btn.primary:hover { color: var(--bg); background: var(--accent); border-color: var(--accent); }

  @media (max-width: 680px) {
    .pv-scene { aspect-ratio: 16 / 9; }
    .pinned-visual { padding: calc(var(--spacing-unit) * 1.5); }
    .pinned-body { padding: calc(var(--spacing-unit) * 0.5) calc(var(--spacing-unit) * 2) calc(var(--spacing-unit) * 3); }
  }

  .archive-pin {
    color: var(--accent);
    flex-shrink: 0;
    display: inline-flex;
  }

  @media (prefers-reduced-motion: reduce) {
    .pv-rain { animation: none; }
  }

  .archive-section {
    margin-bottom: calc(var(--spacing-unit) * 10);
    animation: fade-up 0.5s ease both;
    animation-delay: calc(var(--section-index, 0) * 80ms + 200ms);
  }

  .archive-year-row {
    display: flex;
    align-items: baseline;
    gap: calc(var(--spacing-unit) * 2);
    margin-bottom: calc(var(--spacing-unit) * 3);
  }

  .archive-year {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .archive-label {
    font-size: 0.6rem;
    letter-spacing: 0.15em;
  }

  .archive-list {
    border-top: 1px solid var(--divider);
  }

  .archive-item {
    display: flex;
    align-items: center;
    gap: calc(var(--spacing-unit) * 3);
    padding: calc(var(--spacing-unit) * 2.5) calc(var(--spacing-unit) * 2);
    border-bottom: 1px solid var(--divider);
    text-decoration: none;
    transition: background-color 0.22s ease, transform 0.22s ease;
    cursor: pointer;
    position: relative;
  }

  .archive-item:hover {
    background: var(--accent-dim);
    transform: translateX(3px);
  }

  .archive-item:hover .archive-arrow {
    opacity: 1;
    transform: translate(2px, -2px);
    color: var(--accent);
  }

  .archive-item:hover .archive-title {
    color: var(--text);
  }

  .archive-date {
    min-width: 40px;
    font-size: 0.6rem;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .archive-title {
    flex: 1;
    font-size: 1rem;
    font-weight: 400;
    color: var(--text);
    transition: color 0.15s ease;
    line-height: 1.4;
  }

  .archive-arrow {
    opacity: 0.3;
    color: var(--text-muted);
    flex-shrink: 0;
    transition: opacity 0.15s ease, transform 0.15s ease, color 0.15s ease;
    display: flex;
    align-items: center;
  }

  @media (max-width: 768px) {
    .vertical-text,
    .vol-tag {
      display: none;
    }

    .hero-heading {
      font-size: 1.75rem;
    }
  }

  @media (max-width: 480px) {
    .archive-date {
      display: none;
    }

    .archive-item {
      gap: calc(var(--spacing-unit) * 2);
    }
  }
</style>
